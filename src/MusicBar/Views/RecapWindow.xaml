<Window x:Class="MusicBar.Views.RecapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MusicBar.Infrastructure"
        xmlns:face="clr-namespace:MusicBar.Views.Face"
        Title="{l:Tr Rec_WindowTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFFF6B6B" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <!-- The card: 540 x 675, saved at twice the size (1080 x 1350, a portrait post). -->
        <Border x:Name="CardFrame" CornerRadius="24" Background="#FF0E0F14" MouseLeftButtonDown="Drag">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <Grid x:Name="Card" Width="540" Height="675" ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry x:Name="CardClip" Rect="0,0,540,675" RadiusX="24" RadiusY="24" />
                </Grid.Clip>
                <!-- Night sky in the song's colors -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                            <GradientStop x:Name="SkyTop" Color="#FF221A3B" Offset="0" />
                            <GradientStop Color="#FF111219" Offset="0.55" />
                            <GradientStop Color="#FF0B0C11" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Width="460" Height="460" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-210,-170,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="GlowA" Color="#8CFF6B6B" Offset="0" />
                            <GradientStop Color="#00FF6B6B" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-210,0,0,-190">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="GlowB" Color="#596B8CFF" Offset="0" />
                            <GradientStop Color="#006B8CFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Margin="30,26,30,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 2026, and the face with its mic -->
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="Kicker" Style="{StaticResource Label}" Opacity="0.7" />
                            <TextBlock x:Name="YearText" FontSize="58" FontWeight="Black" Margin="-3,-6,0,-7">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="YearA" Color="#FFFF8A8A" Offset="0" />
                                        <GradientStop x:Name="YearB" Color="#FFFFD27A" Offset="1" />
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock x:Name="Subtitle" FontSize="16" FontWeight="SemiBold" Opacity="0.9" />
                        </StackPanel>
                        <face:FaceView x:Name="Face" Width="150" Height="114" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Margin="0,-4,-10,0" Touchable="False" />
                    </Grid>

                    <!-- Hours -->
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock>
                            <Run x:Name="BigNumber" FontSize="40" FontWeight="Bold" />
                            <Run x:Name="BigUnit" FontSize="16" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock x:Name="Counts" FontSize="12.5" Opacity="0.72" Margin="0,-3,0,0" />
                    </StackPanel>

                    <!-- Top songs -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="SongsLabel" Style="{StaticResource Label}" Margin="0,0,0,5" />
                        <StackPanel x:Name="SongList" />
                    </StackPanel>

                    <!-- Artists -->
                    <StackPanel Grid.Row="3" Margin="0,6,0,0">
                        <TextBlock x:Name="ArtistsLabel" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <StackPanel x:Name="ArtistList" Orientation="Horizontal" ClipToBounds="True" />
                    </StackPanel>

                    <!-- Facts -->
                    <UniformGrid x:Name="Facts" Grid.Row="4" Columns="4" Margin="-4,10,-4,0" />

                    <!-- What kind of listener, and where MusicBar lives -->
                    <Border x:Name="KindBox" Grid.Row="5" VerticalAlignment="Bottom" CornerRadius="14" Padding="16,9,16,10" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="KindLabel" Style="{StaticResource Label}" Opacity="0.75" />
                                <TextBlock x:Name="KindName" FontSize="19" FontWeight="Bold" Margin="0,1,0,0" />
                                <TextBlock x:Name="KindLine" FontSize="12" Opacity="0.78" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="300" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Image Source="pack://application:,,,/Assets/MusicBar.ico" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="MusicBar" FontSize="11.5" FontWeight="SemiBold" Opacity="0.8" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="github.com/lvt1693/music-bar" FontSize="10.5" Opacity="0.55" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Nothing counted yet -->
                <Border x:Name="EmptyCover" Background="#F20E0F14" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="40,0">
                        <TextBlock x:Name="EmptyText" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Not part of the picture -->
        <Border Margin="0,12,0,0" CornerRadius="12" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardEdge}"
                BorderThickness="1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Note" FontSize="11.5" Opacity="0.6" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,10,0" />
                <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource CardSoftButton}" Content="{l:Tr Rec_Copy}" Click="Copy_Click" />
                <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource CardAccentButton}" Margin="8,0,0,0" Content="{l:Tr Rec_Save}" Click="Save_Click" />
                <Button Grid.Column="3" Style="{StaticResource CardIconButton}" Margin="8,0,0,0" Content="&#xE711;" ToolTip="{l:Tr LyrP_Close}" Click="Close_Click" />
            </Grid>
        </Border>
    </StackPanel>
</Window>
