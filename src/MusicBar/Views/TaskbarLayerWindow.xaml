<Window x:Class="MusicBar.Views.TaskbarLayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MusicBar.Views"
        Title="MusicBar Layer"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        Focusable="False" IsHitTestVisible="False"
        Left="-20000" Top="-20000" Width="400" Height="30"
        UseLayoutRounding="True">

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- Taskbar background: dark, tinted or transparent -->
        <Border x:Name="Surface" />
        <!-- Playback progress, drawn in the chosen style -->
        <v:SeekRenderer x:Name="Seek" />
        <!-- A skin's shader paints here instead; the renderer above still keeps time and listens. -->
        <v:SkinView x:Name="SkinHost" Visibility="Collapsed" />
    </Grid>
</Window>
