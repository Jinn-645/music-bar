<Window x:Class="MusicBar.Views.RecapBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MusicBar.Infrastructure"
        xmlns:face="clr-namespace:MusicBar.Views.Face"
        Title="{l:Tr Rec_WindowTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Width="420" SizeToContent="Height" Left="-20000" Top="-20000"
        UseLayoutRounding="True" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFFF6B6B" />
    </Window.Resources>

    <!-- The margin leaves room for the shadow. -->
    <Border Margin="16" CornerRadius="14" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" Padding="18,16,18,14" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="Glow" Color="#FF2A1C30" Offset="0" />
                <GradientStop Color="#F5141418" Offset="0.6" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <face:FaceView x:Name="Face" Width="76" Height="58" VerticalAlignment="Top" Margin="-6,-4,4,0" Touchable="False" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="Body" FontSize="12" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="17" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="NeverBox" Style="{StaticResource CardCheck}" Content="{l:Tr RecB_Never}" Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource CardSoftButton}" Content="{l:Tr RecB_Later}" Click="Later_Click" />
                <Button Style="{StaticResource CardAccentButton}" Margin="8,0,0,0" Content="{l:Tr RecB_Open}" Click="Open_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
