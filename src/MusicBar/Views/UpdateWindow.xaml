<Window x:Class="MusicBar.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MusicBar.Infrastructure"
        Title="{l:Tr Upd_WindowTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Width="420" SizeToContent="Height" Left="-20000" Top="-20000"
        UseLayoutRounding="True" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFFF6B6B" />
    </Window.Resources>

    <!-- The margin leaves room for the shadow. -->
    <Border Margin="16" CornerRadius="14" Background="#F5141418" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="18,16,18,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/MusicBar.ico" Width="36" Height="36" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="Running" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer MaxHeight="200" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Notes" FontSize="12" Opacity="0.85" TextWrapping="Wrap" LineHeight="18" />
            </ScrollViewer>

            <StackPanel x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid Height="4">
                    <Border CornerRadius="2" Background="#33FFFFFF" />
                    <Border x:Name="ProgressFill" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0" />
                </Grid>
                <TextBlock x:Name="ProgressText" FontSize="11" Opacity="0.65" Margin="0,6,0,0" />
            </StackPanel>
            <TextBlock x:Name="Problem" FontSize="12" Foreground="#FFFFA896" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

            <CheckBox x:Name="SkipBox" Style="{StaticResource CardCheck}" Content="{l:Tr Upd_Skip}" Margin="0,14,0,0" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource CardLinkButton}" Content="{l:Tr Upd_Page}" VerticalAlignment="Center" Click="Page_Click" />
                <Button x:Name="LaterButton" Grid.Column="1" Style="{StaticResource CardSoftButton}" Content="{l:Tr Upd_Later}" Click="Later_Click" />
                <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource CardAccentButton}" Margin="8,0,0,0" Click="Update_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
