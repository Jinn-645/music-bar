<Window x:Class="MusicBar.Views.InfoPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicBar Info"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        Focusable="False"
        Left="-20000" Top="-20000" Width="332" SizeToContent="Height"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- The outer margin leaves room for the shadow. -->
    <Grid x:Name="Root" Margin="18,14,18,22" Opacity="0" RenderTransformOrigin="0.5,1"
          MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" />
                <TranslateTransform x:Name="RootShift" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="14" Background="#FF0D0D11">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Card">
            <!-- Ambient backdrop: the cover, hugely blurred, darkened for legibility.
                 A Rectangle (not an Image) so it never drives the card's height. -->
            <Rectangle RenderTransformOrigin="0.5,0.5" Opacity="0.85">
                <Rectangle.Fill>
                    <ImageBrush x:Name="BackdropBrush" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                </Rectangle.RenderTransform>
                <Rectangle.Effect>
                    <BlurEffect Radius="44" KernelType="Gaussian" RenderingBias="Performance" />
                </Rectangle.Effect>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#990B0B0F" Offset="0" />
                        <GradientStop Color="#E00B0B0F" Offset="0.7" />
                        <GradientStop Color="#F00B0B0F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.9" RadiusY="1.2">
                        <GradientStop x:Name="WashStop" Color="#33FF6B6B" Offset="0" />
                        <GradientStop Color="#00FF6B6B" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Border CornerRadius="14" BorderBrush="#26FFFFFF" BorderThickness="1" />

            <Grid Margin="12,12,14,11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cover with the player's icon tucked in its corner -->
                <Grid Width="72" Height="72" VerticalAlignment="Top">
                    <Border CornerRadius="9" Background="#26FFFFFF">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#80FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="9">
                        <Border.Background>
                            <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="9" BorderBrush="#26FFFFFF" BorderThickness="1" />
                    <Border x:Name="SourceBadge" Width="20" Height="20" CornerRadius="6" Background="#F2141418"
                            BorderBrush="#40FFFFFF" BorderThickness="0.8" Padding="2.5"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5">
                        <Image x:Name="SourceIcon" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>

                <!-- Text -->
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15"
                               FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="40" LineHeight="19.5" />
                    <TextBlock x:Name="ArtistText" FontSize="12" Foreground="#D9FFFFFF" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AlbumText" FontSize="11" Foreground="#80FFFFFF" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <WrapPanel x:Name="Chips" Margin="0,6,0,-4" />
                </StackPanel>

                <!-- Progress -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" FontSize="10" Foreground="#99FFFFFF" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" MinWidth="28" />
                    <!-- The seek bar: a tall, invisible hit area around a thin rail that thickens and
                         grows a thumb under the pointer. Click or drag to go to another moment. -->
                    <Grid x:Name="SeekArea" Grid.Column="1" Height="18" Margin="6,0" Background="#01FFFFFF"
                          MouseEnter="Seek_MouseEnter" MouseLeave="Seek_MouseLeave"
                          MouseLeftButtonDown="Seek_MouseDown" MouseMove="Seek_MouseMove" MouseLeftButtonUp="Seek_MouseUp"
                          LostMouseCapture="Seek_LostCapture">
                        <Grid x:Name="Rail" Height="3" Margin="2,0" VerticalAlignment="Center">
                            <Border x:Name="RailTrack" CornerRadius="2.5" Background="#29FFFFFF" />
                            <Border x:Name="ProgressFill" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <Canvas x:Name="ThumbLayer" IsHitTestVisible="False" Margin="2,0">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="White" Opacity="0" Canvas.Top="3">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.5" Color="Black" />
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="ThumbScale" CenterX="6" CenterY="6" ScaleX="0.4" ScaleY="0.4" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="10" Foreground="#99FFFFFF"
                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" MinWidth="28" TextAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
