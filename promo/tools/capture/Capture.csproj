<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders MusicBar's real UI (seekbar styles, lyrics, control center) to image sequences
       for the promo video. Not part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MusicBar\MusicBar.csproj" />
    <!-- MusicBar's windows load these through pack://application, which resolves against this exe. -->
    <Resource Include="..\..\..\src\MusicBar\Assets\MusicBar.ico" Link="Assets\MusicBar.ico" />
    <Resource Include="..\..\..\src\MusicBar\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
