{
  "manifest_version": 3,
  "name": "MusicBar YouTube Captions Bridge",
  "version": "1.0.0",
  "description": "Sends YouTube's timed caption track to MusicBar on localhost.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://127.0.0.1:19693/*"]
}
